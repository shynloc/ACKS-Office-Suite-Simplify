{
  "$schema": "ACKS Studio Design Token System v2.1",
  "version": "2.1.0",
  "_doc": "Single source of truth for all design tokens. Run scripts/build_tokens.py to generate Python constants.",

  "glyph": {
    "_doc": "Shared marker glyphs so bullet/numbered/checklist components render identically across docx and pptx.",
    "BULLET":       "▌",
    "ARROW":        "→",
    "CHECK_EMPTY":  "☐",
    "QUOTE_OPEN":   "“"
  },

  "content_limit": {
    "_doc": "Safe single-line character budgets for large display type, calibrated for Space Grotesk Bold. Components that accept a title should call fit_title_size()/measure-and-shrink rather than assume these are hard caps — they are the point past which auto-shrink kicks in, documented here so authors can write copy that doesn't force it.",
    "SLIDE_H1_CHARS":      18,
    "SLIDE_SECTION_CHARS": 16,
    "SLIDE_H1_BODY_CHARS": 22,
    "SLIDE_H2_CHARS":      24,
    "DOC_H2_CHARS":        28
  },

  "color": {
    "brand": {
      "PRIMARY":        "#FF6B1A",
      "PRIMARY_DEEP":   "#D4530E",
      "PRIMARY_SOFT":   "#FFF1E6"
    },
    "light": {
      "BG_PRIMARY":     "#FFFFFF",
      "BG_SECONDARY":   "#F5F5F7",
      "BG_TERTIARY":    "#EEEEEF",
      "BG_QUATERNARY":  "#E5E5E7",
      "TEXT_PRIMARY":    "#1A1A1A",
      "TEXT_SECONDARY":  "#444444",
      "TEXT_TERTIARY":   "#888888",
      "RULE":            "#D9D9DC",
      "RULE_HEAVY":      "#1A1A1A"
    },
    "dark": {
      "BG_DARK_0":      "#0A0A0C",
      "BG_DARK_1":      "#111114",
      "BG_DARK_2":      "#18181D",
      "BG_DARK_3":      "#1F1F25",
      "RULE_DARK":       "#2A2A30",
      "TEXT_DARK_1":     "#FFFFFF",
      "TEXT_DARK_2":     "#B6B6BE",
      "TEXT_DARK_3":     "#6E6E78"
    },
    "semantic": {
      "GOOD":            "#2A8B5F",
      "GOOD_SOFT":       "#E6F4ED",
      "BAD":             "#C0392B",
      "BAD_SOFT":        "#FBE9E7",
      "INPUT":           "#C8881C",
      "INPUT_SOFT":      "#FFFBEA"
    }
  },

  "font": {
    "family": {
      "DISPLAY_EN":     "Space Grotesk",
      "BODY_EN":        "DM Sans",
      "BODY_CN":        "Noto Sans SC",
      "SERIF_CN":       "Noto Serif SC",
      "MONO":           "JetBrains Mono",
      "FALLBACK_CN":    "PingFang SC",
      "XLSX":           "Aptos"
    },
    "size_pt": {
      "H1":             48,
      "H2":             24,
      "H3":             16,
      "H4":             11,
      "BODY":           10.5,
      "CAPTION":        9,
      "META":           8
    },
    "line_height": {
      "CN":             1.75,
      "EN":             1.60,
      "TIGHT":          1.15,
      "DISPLAY":        1.05
    }
  },

  "spacing_pt": {
    "BASE":            8,
    "S4":              4,
    "S8":              8,
    "S12":             12,
    "S16":             16,
    "S24":             24,
    "S32":             32,
    "S48":             48,
    "S64":             64,
    "S96":             96,
    "PARAGRAPH_BEFORE": 0,
    "PARAGRAPH_AFTER":  6
  },

  "page": {
    "a4": {
      "WIDTH_MM":       210,
      "HEIGHT_MM":      297,
      "MARGIN_TOP_MM":  25,
      "MARGIN_BOTTOM_MM": 22,
      "MARGIN_LEFT_MM": 22,
      "MARGIN_RIGHT_MM": 22,
      "HEADER_DIST_MM": 12,
      "FOOTER_DIST_MM": 12
    }
  },

  "slide": {
    "WIDTH_IN":        13.33333,
    "HEIGHT_IN":       7.5,
    "MARGIN_IN":       1.111,
    "size_pt": {
      "H1":            140,
      "H1_BODY":       100,
      "SECTION":       180,
      "H2":            64,
      "H3":            28,
      "KPI":           80,
      "BODY":          24,
      "EYEBROW":       16,
      "FOOTER":        14,
      "SUB":           28
    }
  },

  "xlsx": {
    "number_format": {
      "INT":            "#,##0",
      "DECIMAL":        "#,##0.00",
      "CNY":            "\"¥\"#,##0;[Red]\"¥\"-#,##0",
      "CNY_M":          "\"¥\"#,##0.0,,\"M\"",
      "USD":            "\"$\"#,##0;[Red]-\"$\"#,##0",
      "PCT":            "0.0%;[Red]-0.0%",
      "PCT_DELTA":      "+0.0%;-0.0%;0.0%",
      "PCT_DELTA_COLOR": "[Green]+0.0%;[Red]-0.0%;0.0%",
      "MULT":           "0.0\"x\"",
      "DATE":           "yyyy.mm.dd",
      "QUARTER":        "yyyy \"Q\"q"
    }
  }
}
